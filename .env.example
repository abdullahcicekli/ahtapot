# Ahtapot Extension - Environment Variables Example
# Copy this file to .env and fill in your API keys

# VirusTotal API Key
# Get yours at: https://www.virustotal.com/gui/join-us
VITE_VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# OTX AlienVault API Key
# Get yours at: https://otx.alienvault.com/api
VITE_OTX_API_KEY=your_otx_api_key_here

# AbuseIPDB API Key
# Get yours at: https://www.abuseipdb.com/register
VITE_ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# MalwareBazaar API Key (Auth Key)
# Get yours at: https://bazaar.abuse.ch/account/
VITE_MALWAREBAZAAR_API_KEY=your_malwarebazaar_auth_key_here

# Shodan API Key
# Get yours at: https://developer.shodan.io/api
VITE_SHODAN_API_KEY=your_shodan_api_key_here

# GreyNoise API Key
# Get yours at: https://viz.greynoise.io/account/details
VITE_GREYNOISE_API_KEY=your_greynoise_api_key_here

# URLhaus API Key (optional, works without key)
# Register at: https://urlhaus.abuse.ch/
VITE_URLHAUS_API_KEY=your_urlhaus_api_key_here

# Pulsedive API Key
# Get yours at: https://pulsedive.com/account/
VITE_PULSEDIVE_API_KEY=your_pulsedive_api_key_here

# Scamalytics API Key
# Register at: https://scamalytics.com/ip/api
VITE_SCAMALYTICS_API_KEY=your_scamalytics_api_key_here

# Development Mode (auto-loads API keys from env)
# Set to true for development, false for production
VITE_DEV_MODE=false
