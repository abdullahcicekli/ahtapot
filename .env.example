# Ahtapot Development Environment Template
# Copy this file to .env and add your API keys

# VirusTotal API Key
# Get yours at: https://www.virustotal.com/gui/my-apikey
VITE_VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# URLhaus API Key
# Get yours at: https://auth.abuse.ch/user/me
VITE_URLHAUS_API_KEY=your_urlhaus_api_key_here

# IBM X-Force Exchange API Key (format: api_key:password)
# Get yours at: https://exchange.xforce.ibmcloud.com/settings/api
VITE_XFORCE_API_KEY=your_xforce_api_key:your_xforce_password

# Pulsedive API Key
# Get yours at: https://pulsedive.com/account/
VITE_PULSEDIVE_API_KEY=your_pulsedive_api_key_here

# Scamalytics API Key
# Get yours at: https://scamalytics.com/ip/api
VITE_SCAMALYTICS_API_KEY=your_scamalytics_api_key_here

# OTX AlienVault API Key
# Get yours at: https://otx.alienvault.com/api
VITE_OTX_API_KEY=your_otx_api_key_here
