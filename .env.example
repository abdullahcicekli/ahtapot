# ===========================================
# Ahtapot Extension - Environment Variables
# ===========================================
# Copy this file to .env and fill in your API keys
# These keys are only used in development mode
# ===========================================

# ---------------------
# Threat Intelligence API Keys
# ---------------------

# VirusTotal - https://www.virustotal.com/gui/join-us
VITE_VIRUSTOTAL_API_KEY=

# URLhaus - No API key required (optional)
VITE_URLHAUS_API_KEY=

# Pulsedive - https://pulsedive.com/api/
VITE_PULSEDIVE_API_KEY=

# Scamalytics - https://scamalytics.com/ip/api
VITE_SCAMALYTICS_API_KEY=

# AlienVault OTX - https://otx.alienvault.com/api
VITE_OTX_API_KEY=

# AbuseIPDB - https://www.abuseipdb.com/api
VITE_ABUSEIPDB_API_KEY=

# Shodan - https://shodan.io/dashboard
VITE_SHODAN_API_KEY=

# GreyNoise - https://viz.greynoise.io/account/api-key
VITE_GREYNOISE_API_KEY=

# MalwareBazaar - https://bazaar.abuse.ch/api/
VITE_MALWAREBAZAAR_API_KEY=

# ---------------------
# AI Provider API Keys
# ---------------------

# Claude (Anthropic) - https://console.anthropic.com/settings/keys
VITE_CLAUDE_API_KEY=

# Gemini (Google) - https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# OpenAI - https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=
