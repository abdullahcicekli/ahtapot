{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "3.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "ahtapot@ioc-analysis.security",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "menus",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.virustotal.com/*",
    "https://otx.alienvault.com/*",
    "https://api.abuseipdb.com/*",
    "https://bazaar.abuse.ch/*",
    "https://urlhaus-api.abuse.ch/*",
    "https://whois.arin.net/*",
    "https://api.shodan.io/*",
    "https://api.greynoise.io/*",
    "https://pulsedive.com/*",
    "https://api12.scamalytics.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["provider-icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "scripts": ["src/background/service-worker.ts"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-script.tsx"],
      "css": ["src/content/content-script.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "src/pages/popup/index.html",
    "default_title": "Ahtapot IOC Analysis"
  },
  "options_ui": {
    "page": "src/pages/options/index.html",
    "open_in_tab": true
  },
  "sidebar_action": {
    "default_panel": "src/pages/sidepanel/index.html",
    "default_title": "Ahtapot IOC Analysis",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
